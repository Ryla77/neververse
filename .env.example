# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env ke repository publik.

APP_NAME="Luminara"
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
# URL publik aplikasi. Wajib di produksi agar tautan email tidak bergantung header Host.
# Sertakan subdirektori bila aplikasi tidak berada di root domain.
APP_URL=http://localhost/novelverse

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novelverse
DB_USER=novelverse
DB_PASS=ganti-dengan-password-kuat

# Kredensial root MySQL hanya dipakai saat instalasi (bin/install.php).
# Kosongkan DB_ROOT_PASS jika root XAMPP belum diberi password.
DB_ROOT_USER=root
DB_ROOT_PASS=

UPLOAD_MAX_KB=2048

# Email untuk reset kata sandi.
# file = tulis ke storage/mail (default lokal, tanpa server email)
# mail = kirim melalui fungsi mail() server (produksi)
# smtp = kirim langsung ke server SMTP (disarankan untuk produksi)
MAIL_TRANSPORT=file
MAIL_FROM_ADDRESS=no-reply@novelverse.local
MAIL_FROM_NAME="Luminara"

# Konfigurasi SMTP (dipakai bila MAIL_TRANSPORT=smtp).
# Kredensial di bawah hanya dikirim melalui koneksi TLS. Jangan commit nilai asli.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_TIMEOUT=15
# MAIL_HELO=localhost
# File CA kustom untuk server dengan sertifikat internal. Kosongkan untuk CA sistem.
# MAIL_CAFILE=

# Masa berlaku tautan reset kata sandi dalam menit (minimal 5).
PASSWORD_RESET_TTL=60

# Masa berlaku tautan verifikasi email dalam menit (default 24 jam).
EMAIL_VERIFICATION_TTL=1440

# Kunci enkripsi rahasia 2FA (AES-256-GCM). Wajib untuk mengaktifkan 2FA.
# Buat dengan: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Jangan ganti nilai ini setelah ada pengguna mengaktifkan 2FA.
APP_KEY=
